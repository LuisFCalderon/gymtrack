# Netlify / Cloudflare Pages leen este archivo tal cual.
# El objetivo es que el Service Worker y el HTML nunca queden pegados en una
# versión vieja, mientras que los assets con hash se cachean para siempre.

/sw.js
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable
